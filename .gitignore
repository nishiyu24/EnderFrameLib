# ビルド成果物
/.gradle/
/build/
/core/build/
/core/.gradle/
/repo/

# データジェネレータの出力（build.gradle が srcDir として読むが、生成物なので追跡しない）
/src/generated/

# 開発用の Minecraft 実行ディレクトリ（ワールド・設定・ログ・DL キャッシュ）
/run/

# IDE
/.idea/
*.iml
/.vscode/
/.eclipse/
/bin/

# ログ
*.log
*.log.gz
hs_err_pid*.log
/.agents/
/.gemini/

# IDE のビルド出力
/out/
/logs/

# core 配下のドキュメント（README 以外は追跡対象外）
/core/**/*.md
!/core/**/README.md


# G0: GPU 出力の基準画像（フォント依存なのでマシンごとに生成）
/core/baseline/

# G4 の分離モジュールのビルド成果物
/core-gl/build/
/core-vulkan/build/
/core-glfw/build/

# A10: 公開物の検査用プロジェクトの生成物
/scripts/consumer-check/.gradle/
/scripts/consumer-check/build/
